{
  "version": 2,
  "functions": {
    "api/mcp/manifest.js": {
      "includeFiles": "public/*.html"
    },
    "api/assets/[id]/download.js": {
      "includeFiles": "souls/**/*.md"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/mcp/manifest.js?view=home",
      "methods": ["GET", "HEAD"]
    },
    {
      "src": "/mcp",
      "dest": "/api/retired.js?path=mcp"
    },
    {
      "src": "/api/mcp",
      "dest": "/api/retired.js?path=api/mcp"
    },
    {
      "src": "/api/mcp/manifest",
      "dest": "/api/retired.js?path=api/mcp/manifest"
    },
    {
      "src": "/api/assets/([^/]+)/download",
      "dest": "/api/assets/[id]/download.js?id=$1"
    },
    {
      "src": "/assets/([^/]+)",
      "dest": "/api/mcp/manifest.js?view=retired&path=assets/$1"
    },
    {
      "src": "/asset\\.html",
      "dest": "/api/mcp/manifest.js?view=retired&path=asset.html"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/mcp/manifest.js?view=sitemap"
    },
    {
      "src": "/\\.well-known/api-catalog",
      "dest": "/api/retired.js?path=.well-known/api-catalog"
    },
    {
      "src": "/\\.well-known/(.*)",
      "dest": "/api/retired.js?path=.well-known/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/retired.js?path=api/$1"
    },
    {
      "src": "/WEBMCP\\.md",
      "dest": "/api/retired.js?path=WEBMCP.md"
    },
    {
      "src": "/(index|admin|create|security)\\.html",
      "dest": "/api/mcp/manifest.js?view=retired&path=$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
