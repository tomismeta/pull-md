{
  "name": "pull-md",
  "version": "1.0.0",
  "type": "module",
  "description": "Archived source for the retired PULL.md markdown asset marketplace",
  "scripts": {
    "start": "vercel dev",
    "deploy": "vercel --prod",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "test": "node --test tests/*.test.js",
    "test:all": "npm run test && node --check public/js/app.js && node --check public/js/create.js && node --check public/js/admin.js && node --check public/js/lib/webmcp.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:export-retirement": "node scripts/export-retirement-backup.js",
    "db:cutover-neon": "node scripts/cutover-neon.js"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@coinbase/cdp-sdk": "^1.55.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.22.0",
    "@x402/evm": "^2.22.0",
    "@x402/extensions": "^2.22.0",
    "@x402/fetch": "^2.22.0",
    "@x402/next": "^2.22.0",
    "confusables": "^1.1.1",
    "ethers": "^6.17.0",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.0",
    "quick-lru": "^7.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tldts": "^7.4.10",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "vercel": "^58.9.4"
  },
