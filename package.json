    "hono": "4.13.2",
    "@hono/node-server": "2.1.1",
    "express-rate-limit": "8.6.2",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "next": "16.3.1",
    "postcss": "8.5.26",
    "form-data": "4.0.6",
    "qs": "6.15.2",
    "path-to-regexp": "8.4.2",
    "ws": "8.21.0",
    "sharp": "0.35.3",
    "smol-toml": "1.6.1",
    "basic-ftp": "5.3.1",
